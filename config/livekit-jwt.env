export LIVEKIT_URL=wss://{{{ .Domain }}}/livekit/sfu
export LIVEKIT_KEY_FILE={{{ .DataDir }}}/livekit.keys
export LIVEKIT_FULL_ACCESS_HOMESERVERS={{{ .Domain }}}
export LIVEKIT_JWT_BIND=unix:{{{ .DataDir }}}/livekit-jwt.sock
export SSL_CERT_FILE=/var/snap/platform/current/syncloud.ca.crt
export SSL_CERT_DIR=/etc/ssl/certs
